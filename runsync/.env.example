# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/runsync?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Upstash Redis
# Use the "ioredis-compatible" connection string Upstash gives you, e.g.:
# rediss://default:<password>@<region>.upstash.io:6379
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
